/*
 * Device tree overlay for XIAO nRF52840 Sense
 * Enables PDM microphone for USB audio
 */

#include "xiao_ble-pinctrl.dtsi"

&pdm0 {
	status = "okay";
	pinctrl-0 = <&pdm0_default>;
	pinctrl-1 = <&pdm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&zephyr_udc0 {
	mic_0 {
		compatible = "usb-audio-mic";
		feature-mute;
		channel-l;
		sample-rate-hz = <48000>;
		resolution = <16>;
	};
};

/* Enable ADC for coil monitoring on A0 */
&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN0>; /* A0 = P0.02 */
		zephyr,resolution = <12>;
	};
};
